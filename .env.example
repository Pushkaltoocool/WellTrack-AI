# Copy to .env.local and fill in. EXPO_PUBLIC_* values are inlined into the JS bundle.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# DEV ONLY: a key in the bundle is extractable. For release, set EXPO_PUBLIC_AI_PROXY_URL instead (see functions/).
EXPO_PUBLIC_OPENROUTER_API_KEY=
EXPO_PUBLIC_AI_PROXY_URL=
